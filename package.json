{
  "name": "@olaurendeau/mcp-camptocamp",
  "version": "1.0.3",
  "description": "MCP server exposing Camptocamp.org API to LLMs",
  "mcpName": "io.github.olaurendeau/mcp-camptocamp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-camptocamp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/olaurendeau/mcp-camptocamp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "camptocamp",
    "alpinisme",
    "montagne",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
