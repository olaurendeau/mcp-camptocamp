          "mountain_biking",
          "via_ferrata",
          "slacklining",
        ],
        "type": "string",
      },
      "area_id": {
        "description": "Camptocamp area ID from search_areas (e.g. 14409 for Vanoise)",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "condition_at_least": {
        "description": "Conditions the outing's author reported, this value or better; from best to worst: excellent, good, average, poor, awful (outings without reported conditions are excluded)",
        "enum": [
          "excellent",
          "good",
          "average",
          "poor",
          "awful",
        ],
        "type": "string",
      },
      "date_from": {
        "description": "Earliest date (YYYY-MM-DD); matches outings whose date range ends on or after it. An outing matches if its date range overlaps the requested range; give one bound only for 'since' / 'until'.",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string",
      },
      "date_to": {
        "description": "Latest date (YYYY-MM-DD); matches outings whose date range starts on or before it. An outing matches if its date range overlaps the requested range; give one bound only for 'since' / 'until'.",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string",
      },
      "height_diff_up_max": {
        "description": "Highest elevation gain in metres, inclusive (outings without an elevation gain are excluded)",
