        ],
        "type": "string",
      },
      "route_types": {
        "description": "Route types, matching any of: return_same_way, loop, loop_hut, traverse, raid, expedition",
        "items": {
          "enum": [
            "return_same_way",
            "loop",
            "loop_hut",
            "traverse",
            "raid",
            "expedition",
          ],
          "type": "string",
        },
        "minItems": 1,
        "type": "array",
      },
      "waypoint_id": {
        "description": "Camptocamp waypoint ID from search_waypoints: routes associated with this summit, hut, crag… (e.g. 37916 for Mont Pourri)",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
    },
    "type": "object",
  },
  "search_user_outings": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "lang": {
        "description": "Language of titles and texts, one of: fr, en, de, it, es, ca, eu, sl, zh (default fr)",
        "enum": [
          "fr",
          "en",
          "de",
          "it",
          "es",
          "ca",
          "eu",
          "sl",
          "zh",
        ],
        "type": "string",
      },
      "limit": {
        "default": 10,
        "description": "Maximum number of results",
        "maximum": 50,
        "minimum": 1,
        "type": "integer",
      },
      "offset": {
        "default": 0,
        "description": "Number of results to skip, for paging (offset + limit ≤ 10,000)",
        "minimum": 0,
        "type": "integer",
      },
      "user_id": {
        "description": "Camptocamp user ID (the number in their profile URL): outings this user is listed on as a participant, not only those they wrote",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
    },
    "required": [
      "user_id",
    ],
    "type": "object",
  },
  "search_waypoints": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "area_id": {
        "description": "Camptocamp area ID from search_areas (e.g. 14403 for Écrins)",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "lang": {
        "description": "Language of titles and texts, one of: fr, en, de, it, es, ca, eu, sl, zh (default fr)",
        "enum": [
          "fr",
          "en",
          "de",
          "it",
          "es",
          "ca",
          "eu",
          "sl",
          "zh",
        ],
        "type": "string",
      },
      "limit": {
        "default": 10,
        "description": "Maximum number of results",
        "maximum": 50,
        "minimum": 1,
        "type": "integer",
      },
      "offset": {
        "default": 0,
        "description": "Number of results to skip, for paging (offset + limit ≤ 10,000)",
        "minimum": 0,
        "type": "integer",
      },
      "query": {
        "description": "Search query for waypoints (e.g. 'Mont Blanc', 'refuge Goûter')",
        "maxLength": 200,
        "type": "string",
      },
      "waypoint_type": {
        "description": "Waypoint type, one of: summit, pass, lake, waterfall, locality, bisse, canyon, access, climbing_outdoor, climbing_indoor, hut, gite, shelter, bivouac, camp_site, base_camp, local_product, paragliding_takeoff, paragliding_landing, cave, waterpoint, weather_station, webcam, virtual, slackline_spot, misc (hut = mountain hut, climbing_outdoor = crag, access = trailhead or parking). Narrows a query or area_id; not a filter on its own",
        "enum": [
          "summit",
          "pass",
          "lake",
          "waterfall",
          "locality",
          "bisse",
          "canyon",
          "access",
          "climbing_outdoor",
          "climbing_indoor",
