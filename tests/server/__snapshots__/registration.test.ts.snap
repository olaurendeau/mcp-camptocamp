        "type": "string",
      },
      "limit": {
        "default": 10,
        "description": "Maximum number of results",
        "maximum": 50,
        "minimum": 1,
        "type": "integer",
      },
      "max_elevation_max": {
        "description": "Highest max elevation reached in metres, inclusive (outings without a max elevation are excluded)",
        "minimum": 0,
        "type": "integer",
      },
      "max_elevation_min": {
        "description": "Lowest max elevation reached in metres, inclusive (outings without a max elevation are excluded)",
        "minimum": 0,
        "type": "integer",
      },
      "offset": {
        "default": 0,
        "description": "Number of results to skip, for paging (offset + limit ≤ 10,000)",
        "minimum": 0,
        "type": "integer",
      },
      "period_end": {
        "description": "Last day (MM-DD) of a period matched in every year, on or after period_start (e.g. 06-30). A period cannot wrap around the new year, so make two calls for 12-20 → 01-10; Camptocamp's period filter can miss outings on the first or last day of the range.",
        "pattern": "^\\d{2}-\\d{2}$",
        "type": "string",
      },
      "period_start": {
        "description": "First day (MM-DD) of a period matched in every year; give period_end too (e.g. 06-01). A period cannot wrap around the new year, so make two calls for 12-20 → 01-10; Camptocamp's period filter can miss outings on the first or last day of the range.",
        "pattern": "^\\d{2}-\\d{2}$",
        "type": "string",
      },
      "query": {
        "description": "Keyword matched against outing titles (e.g. 'cosmiques')",
        "maxLength": 200,
        "type": "string",
      },
      "rating_max": {
        "description": "Hardest rating to include, from the scale of rating_system (e.g. 'AD' for global_rating)",
